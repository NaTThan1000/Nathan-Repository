{
  "_schema": {
    "_description": "怪物数据库 — 每只怪物的属性、AI行为、掉落配置",
    "_fields": {
      "aiType": {
        "_values": ["chase", "ranged_kite", "charge", "boss_jumper", "boss_chase", "boss_duke"],
        "_desc": "chase=追逐玩家, ranged_kite=远程风筝, charge=蓄力冲刺, boss_jumper=跳跃Boss, boss_chase=追逐Boss, boss_duke=公爵Boss"
      },

      "actionMode.mode": {
        "_values": ["sequence", "random"],
        "_desc": "sequence=顺序执行actions, random=按weights权重随机选action"
      },
      "actions[].type": {
        "_values": ["chase", "random_wander", "shoot_fan", "shoot_single", "charge_up", "charge_line", "jump_small", "jump_big_land", "duke_idle", "duke_diagonal_move"],
        "_desc": "AI行动类型。shoot_single=单发直射, charge_up=蓄力(原地+感叹号), charge_line=冲刺, jump_big_land=大跳(chargeSteps蓄力→砸下), duke_idle=公爵首回合静止, duke_diagonal_move=公爵对角移动"
      },
      "actions[].stepMode": {
        "_values": ["sequence", "random"],
        "_desc": "sequence=按steps数组顺序移动, random=从steps中随机选一步"
      },
      "actions[].directMode": {
        "_values": ["toward_player_axis"],
        "_desc": "射击方向模式"
      },
      "actions[].condition": {
        "_values": ["in_range"],
        "_desc": "行动触发条件"
      },
      "actions[].target.mode": {
        "_values": ["cover_player"],
        "_desc": "跳跃落点模式: cover_player=覆盖玩家所在格"
      },
      "actions[].after_effect[].type": {
        "_values": ["attack_adjacent", "attack_side", "summon", "random_wander"],
        "_desc": "行动后附带的攻击效果: attack_adjacent=邻格攻击, attack_side=侧面攻击, summon=召唤怪物, random_wander=随机移动"
      },
      "actions[].once": {
        "_desc": "仅首回合执行一次（true则后续回合跳过此action），用于boss_duke的首回合静止",
        "_type": "boolean"
      },
      "actions[].after_effect.chance": {
        "_desc": "summon类型的召唤概率 (0~1)",
        "_type": "number"
      },
      "actions[].after_effect.monsterId": {
        "_desc": "summon类型召唤的怪物cfgId",
        "_type": "string"
      },
      "actions[].after_effect.maxCount": {
        "_desc": "summon类型召唤的怪物在场数量上限",
        "_type": "number"
      },
      "actions[].after_effect.spawnRange": {
        "_values": ["adjacent"],
        "_desc": "summon类型召唤位置: adjacent=相邻格随机空格"
      },
      "loot.mode": {
        "_values": ["pick_one", "roll_all", "pick_first"],
        "_default": "pick_one",
        "_desc": "pick_one=按权重抽一个条目执行, roll_all=每个条目独立判定, pick_first=按顺序命中第一个就停"
      },
      "loot.rounds[].entries[].type": {
        "_values": ["item", "resource", "resource_fixed", "nothing"],
        "_desc": "item=随机道具(需itemDropTable), resource=按掉落表生成资源(需resourceDropTable), resource_fixed=固定资源(需id), nothing=空掉落"
      },
      "loot.rounds[].entries[].itemDropTable": {
        "_desc": "道具掉落表名，对应 item-db.json > itemDropTables 中的 key"
      },
      "loot.rounds[].entries[].resourceDropTable": {
        "_desc": "资源掉落表名，对应 resource-db.json > resourceDropTables 中的 key"
      }
    }
  },

