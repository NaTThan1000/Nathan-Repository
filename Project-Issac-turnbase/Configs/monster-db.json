{
  "_schema": {
    "_description": "怪物数据库 — 每只怪物的属性、AI行为、掉落配置",
    "_fields": {
      "aiType": {
        "_values": ["chase", "ranged_kite", "charge", "boss_jumper", "boss_chase"],
        "_desc": "chase=追逐玩家, ranged_kite=远程风筝, charge=蓄力冲刺, boss_jumper=跳跃Boss, boss_chase=追逐Boss"
      },
      "role": {
        "_values": ["melee", "ranged", "tank", "boss"],
        "_desc": "怪物定位分类"
      },
      "roomTypes": {
        "_values": ["normal", "treasure", "boss"],
        "_desc": "怪物可出现的房间类型"
      },
      "movementTags": {
        "_values": ["地面", "飞行"],
        "_desc": "移动标签，匹配房间 spawnConfig.allowedMovement"
      },
      "actionMode.mode": {
        "_values": ["sequence", "random"],
        "_desc": "sequence=顺序执行actions, random=按weights权重随机选action"
      },
      "actions[].type": {
        "_values": ["chase", "random_wander", "shoot_fan", "charge_up", "charge_line", "jump_small", "jump_big_land"],
        "_desc": "AI行动类型。charge_up=蓄力(原地+感叹号), charge_line=冲刺"
      },
      "actions[].stepMode": {
        "_values": ["sequence", "random"],
        "_desc": "sequence=按steps数组顺序移动, random=从steps中随机选一步"
      },
      "actions[].directMode": {
        "_values": ["toward_player_axis"],
        "_desc": "射击方向模式"
      },
      "actions[].condition": {
        "_values": ["in_range"],
        "_desc": "行动触发条件"
      },
      "actions[].target.mode": {
        "_values": ["cover_player"],
        "_desc": "跳跃落点模式: cover_player=覆盖玩家所在格"
      },
      "actions[].after_effect[].type": {
        "_values": ["attack_adjacent", "attack_side"],
        "_desc": "行动后附带的攻击效果: attack_adjacent=邻格攻击, attack_side=侧面攻击"
      },
      "loot.mode": {
        "_values": ["pick_one", "roll_all", "pick_first"],
        "_default": "pick_one",
        "_desc": "pick_one=按权重抽一个条目执行, roll_all=每个条目独立判定, pick_first=按顺序命中第一个就停"
      },
      "loot.rounds[].entries[].type": {
        "_values": ["item", "resource_pool", "resource_fixed", "nothing"],
        "_desc": "item=随机道具(需qualityTable), resource_pool=按掉落表生成资源(需pool), resource_fixed=固定资源(需id), nothing=空掉落"
      },
      "loot.rounds[].entries[].qualityTable": {
        "_desc": "道具品质表名，对应 item-db.json > qualityTables 中的 key"
      },
      "loot.rounds[].entries[].pool": {
        "_desc": "资源掉落表名，对应 resource-db.json > dropTables 中的 key"
      }
    }
  },

