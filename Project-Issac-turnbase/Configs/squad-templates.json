      "squads.<id>.monsters": { "_desc": "怪物 cfgId 列表，对应 monster-db.json 中的怪物 ID" },
      "squads.<id>.budget": { "_desc": "该小队的预算消耗值，贪心选取时累计不能超过房间 budget" },
