{
  "_schema": {
    "_description": "房间模板池 — 定义各种房间模板的布局、适用类型、刷怪参数",
    "_fields": {
      "tplKey": { "_desc": "模板key，被 floor-data.json 中 room.tplKey 引用" },
      "tplKey.types": {
        "_values": ["start", "normal", "treasure", "shop", "boss"],
        "_desc": "该模板可被哪些房间类型使用"
      },
      "tplKey.tiles": {
        "_desc": "瓦片网格，每行最多13字符。字符含义: .=地板, #=岩石, P=便便, ^=尖刺, O=宝箱, 数字=自定义",
        "_legend": { ".": "地板(可行走)", "#": "岩石(可破坏)", "P": "便便(可破坏)", "^": "尖刺(伤害)", "O": "宝箱(可开启)", "1-4": "自定义" }
      },
      "tplKey.spawnConfig.allowedMovement": {
        "_values": ["地面", "飞行"],
        "_desc": "允许在此模板生成的怪物移动类型，需匹配 monster-db.json 中 monster.movementTags"
      },
      "tplKey.spawnConfig.minMonsters": { "_desc": "最少刷怪数量" },
      "tplKey.spawnConfig.maxMonsters": { "_desc": "最多刷怪数量" },
      "tplKey.spawnConfig.budget": { "_desc": "怪物预算上限 (每只怪消耗 = threat值)" }
    }
  },

