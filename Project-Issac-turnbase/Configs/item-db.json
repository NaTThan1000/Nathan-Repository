{
  "_schema": {
    "_description": "道具数据库 — 所有可拾取道具的属性与效果定义 + 道具掉落表",
    "_structure": {
      "items": "所有道具定义 (key=cgId, value=道具属性)",
      "itemDropTables": "道具掉落表，每张表结构 { mode, table }。mode 当前统一为 pick_one(权重抽1个品质，再从品质池均匀随机具体道具)。table 中 key=品质(none/common/rare/legendary)，value=权重(整数)。"
    },
    "_fields": {
      "quality": {
        "_values": ["common", "rare", "legendary"],
        "_desc": "道具品质等级，决定出现在哪个掉落池"
      },
      "tags": {
        "_values_examples": ["属性提升", "攻击", "HP", "射速", "射程", "移速", "穿透", "回复", "全属性", "伤害倍率"],
        "_desc": "道具标签，用于分类筛选"
      },
      "specials[].type": {
        "_values": ["heal_full", "piercing", "damage_mult"],
        "_desc": "heal_full=回满血, piercing=子弹穿透, damage_mult=伤害倍率"
      },
      "effects": {
        "_keys": ["maxHp", "attack", "fireRate", "moveSpeed", "range"],
        "_desc": "追加的属性修正值"
      },
      "price": {
        "_desc": "商店售价（金币），默认15",
        "_type": "number"
      },
      "itemDropTables.*.mode": {
        "_values": ["pick_one"],
        "_desc": "掉落模式：pick_one=按权重抽1个品质，再从品质池均匀随机具体道具"
      },
      "itemDropTables.*.table.none": { "_desc": "不掉落道具权重 (整数), 0=必定掉落", "_type": "number" },
      "itemDropTables.*.table.common": { "_desc": "普通品质权重 (整数)", "_type": "number" },
      "itemDropTables.*.table.rare": { "_desc": "稀有品质权重 (整数)", "_type": "number" },
      "itemDropTables.*.table.legendary": { "_desc": "传说品质权重 (整数)", "_type": "number" }
    }
  },

