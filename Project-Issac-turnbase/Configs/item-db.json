{
  "_schema": {
    "_description": "道具数据库 — 所有可拾取道具的属性与效果定义 + 道具掉落表",
    "_structure": {
      "items": "所有道具定义 (key=cgId, value=道具属性)",
      "itemDropTables": "道具品质概率表 (key=表名, value={common,rare,legendary})"
    },
    "_fields": {
      "quality": {
        "_values": ["common", "rare", "legendary"],
        "_desc": "道具品质等级，决定出现在哪个掉落池"
      },
      "tags": {
        "_values_examples": ["属性提升", "攻击", "HP", "射速", "射程", "移速", "穿透", "回复", "全属性", "伤害倍率"],
        "_desc": "道具标签，用于分类筛选"
      },
      "specials[].type": {
        "_values": ["heal_full", "piercing", "damage_mult"],
        "_desc": "heal_full=回满血, piercing=子弹穿透, damage_mult=伤害倍率"
      },
      "effects": {
        "_keys": ["maxHp", "attack", "fireRate", "moveSpeed", "range"],
        "_desc": "追加的属性修正值"
      },
      "itemDropTables.*.none": { "_desc": "不掉落道具概率 (0~1), 0=必定掉落, 1=完全不掉落", "_type": "number" },
      "itemDropTables.*.common": { "_desc": "普通品质概率 (0~1)", "_type": "number" },
      "itemDropTables.*.rare": { "_desc": "稀有品质概率 (0~1)", "_type": "number" },
      "itemDropTables.*.legendary": { "_desc": "传说品质概率 (0~1)", "_type": "number" }
    }
  },

