{
  "_schema": {
    "_description": "资源数据库 — 金币、炸弹、红心、蓝心、宝箱、钥匙等可拾取资源的定义与掉落配置",
    "_fields": {
      "resources.*.type": {
        "_values": ["coin", "bomb", "heart", "blue_heart", "chest", "key"],
        "_desc": "资源类型"
      },
      "dropTables": {
        "_desc": "资源掉落表，被 monster-db.json > loot > entries[].pool 引用",
        "_tables": {
          "monster_default": "普通小怪 (threat<3) 掉落",
          "monster_heavy": "重型小怪 (threat≥3) 掉落",
          "boss_drop": "Tank怪/Boss怪击杀掉落",
          "room_clear_default": "普通房间清空奖励",
          "room_clear_boss": "Boss房间清空奖励",
          "terrain_rock": "破坏岩石掉落",
          "terrain_poop": "破坏便便掉落",
          "chest_normal": "普通宝箱",
          "chest_golden": "金宝箱(需钥匙)",
          "shop_stock": "商店商品生成"
        }
      },
      "_limits": {
        "_desc": "玩家资源上限",
        "coinMax": "金币上限",
        "bombMax": "炸弹上限",
        "keyMax": "钥匙上限"
      }
    }
  },

