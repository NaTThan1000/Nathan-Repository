{
  "_schema": {
    "_description": "资源数据库 — 金币、炸弹、红心、蓝心、宝箱、钥匙等可拾取资源的定义与掉落配置",
    "_fields": {
      "resources.*.type": {
        "_values": ["coin", "bomb", "heart", "blue_heart", "chest", "key"],
        "_desc": "资源类型"
      },
      "dropTables": {
        "_desc": "资源掉落表，每张表结构 { mode, table }。mode: pick_one(权重抽1) / roll_all(每种独立判定) / pick_first(顺序首个命中即停)。被 monster-db.json > loot > entries[].pool 引用",
        "_tables": {
          "monster_default": "普通小怪 (threat<3) 掉落 — pick_one",
          "monster_heavy": "重型小怪 (threat≥3) 掉落 — pick_one",
          "boss_drop": "Tank怪/Boss怪击杀掉落 — pick_one",
          "room_clear_default": "普通/商店/起始房间清空奖励 — pick_one",
          "room_clear_boss": "Boss房间清空奖励 — pick_one(空table)",
          "room_clear_treasure": "宝藏房间清空奖励 — pick_one(空table)",
          "terrain_rock": "破坏岩石掉落 — pick_one",
          "terrain_poop": "破坏便便掉落 — pick_one",
          "chest_normal": "普通宝箱额外资源 — pick_one",
          "chest_golden": "金宝箱(需钥匙)额外资源 — pick_one",
          "shop_stock": "商店商品生成 — roll_all"
        }
      },
      "_limits": {
        "_desc": "玩家资源上限",
        "coinMax": "金币上限",
        "bombMax": "炸弹上限",
        "keyMax": "钥匙上限"
      }
    }
  },

